# Keep Unix line endings for scripts even when the repository is committed
# from Windows (CRLF line endings break bash and Rscript shebangs).
*.sh                text eol=lf
test/stubs/*        text eol=lf
*.R                 text eol=lf
*.Rmd               text eol=lf
*.md                text eol=lf
*.yml               text eol=lf
*.cff               text eol=lf
*.json              text eol=lf
*.dot               text eol=lf
*.csv               text eol=lf
# Binary files
*.pdf               binary
*.png               binary
*.docx              binary
